# Naukri Pulse Script Configuration

# Browser Settings
HEADLESS=false

# Timing Configuration (in seconds)
MIN_DELAY_SECONDS=1200
MAX_DELAY_SECONDS=1800

# Naukri URLs
NAUKRI_PROFILE_URL=https://www.naukri.com/mnjuser/profile

# Resume Headlines Pool (comma-separated)
HEADLINE_POOL=Experienced Software Developer,Full Stack Engineer,Senior Backend Developer,DevOps Engineer,Cloud Solutions Architect,Technical Lead,Software Engineering Manager,Senior Frontend Developer,Data Engineer,Machine Learning Engineer

# Headline Configuration
APPEND_TIMESTAMP=false

# Browser Timeout (in milliseconds)
TIMEOUT_MS=45000

# Execution Configuration
RUNS=0

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Storage Paths
STORAGE_STATE_PATH=auth/storageState.json
LAST_HEADLINE_PATH=artifacts/last_headline.txt
UPDATES_LOG_PATH=artifacts/updates.log
SCREENSHOTS_PATH=artifacts/